PORT=5001
NODE_ENV=development

# MongoDB — domestic database (separate from international LMS)
DOM_MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/domesticdb

# JWT — completely separate secret from international LMS
DOM_JWT_SECRET=change-this-in-production
DOM_JWT_EXPIRE=7d

# API key that mycashbridge website uses to push leads into this LMS
DOM_WEBSITE_API_KEY=change-this-in-production

# CORS — domestic client origin
CORS_ORIGIN=http://localhost:3002

# File uploads
UPLOAD_PATH=uploads
MAX_FILE_SIZE_MB=10
